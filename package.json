{
  "name": "modernClassicalMechanics",
  "version": "1.0.0",
  "private": true,
  "description": "MyST textbook on modern classical mechanics",
  "license": "CC-BY-NC-4.0",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": ">=26",
    "npm": ">=11 <12"
  },
  "scripts": {
    "start": "myst start",
    "build": "myst build --html --execute --strict && node scripts/setup-pwa.mjs",
    "verify": "python3 scripts/verify_book.py",
    "check": "npm run verify && myst build --html --execute --strict --check-links && node scripts/setup-pwa.mjs",
    "build:exports": "scripts/build-exports.sh all",
    "build:pdf": "scripts/build-exports.sh pdf",
    "build:docx": "scripts/build-exports.sh docx"
  },
  "devDependencies": {
    "mystmd": "1.12.0",
    "sharp": "0.35.5",
    "yaml": "2.9.1"
  }
}
